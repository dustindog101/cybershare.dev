---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Integrations from '../components/Integrations.astro';
import Why from '../components/Why.astro';
import Services from '../components/Services.astro';
import Included from '../components/Included.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import Results from '../components/Results.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Cybershare Design | Websites for Restaurants, Auto Shops & Local Businesses"
  description="Simple websites for local businesses: restaurants, shops, and auto repair. Ordering, bookings, and calls built in, plus 30 days of free changes and one clear price. Contact us."
>
  <Header />
  <main id="main">
    <Hero />
    <Integrations />
    <Why />
    <Services />
    <Results />
    <Included />
    <Pricing />
    <Process />
    <CTA />
  </main>
  <Footer />

  <script>
    // Reveal-on-scroll via IntersectionObserver (respects prefers-reduced-motion in CSS)
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('in'));
    }
  </script>
</BaseLayout>