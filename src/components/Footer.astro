---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="nav__logo" href="#top" aria-label="Cybershare Design home">
          <span class="nav__logo-mark" aria-hidden="true">C</span>
          <span>cybershare<span class="dot">.</span>dev</span>
        </a>
        <p>Websites for restaurants, auto shops, and every local business in between. Built in the DMV, made for Main Street. We explain everything in plain English.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="#why">Why a website</a></li>
          <li><a href="#services">Our sites</a></li>
          <li><a href="#pricing">Your price</a></li>
          <li><a href="#process">How it works</a></li>
          <li><a href="#locals">Local favorites</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:hello@cybershare.dev">hello@cybershare.dev</a></li>
          <li><a href="#contact">Get a free quote</a></li>
        </ul>
      </div>
      <div>
        <h4>Serving</h4>
        <ul>
          <li><a href="#locals" rel="nofollow">Baltimore</a></li>
          <li><a href="#locals" rel="nofollow">Montgomery County</a></li>
          <li><a href="#locals" rel="nofollow">The DMV</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p>© {year} Cybershare Design. Websites for local businesses.</p>
      <p>Made in Maryland, for Main Street.</p>
    </div>
  </div>
</footer>

<script>
  const links = document.querySelectorAll('.footer a[href^="#"]');
  links.forEach((a) =>
    a.addEventListener('click', (e) => {
      const t = document.querySelector(a.hash);
      if (t) {
        e.preventDefault();
        t.scrollIntoView({ behavior: 'smooth' });
      }
    })
  );
</script>