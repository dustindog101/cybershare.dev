---
const stats = [
  { value: '2', unit: 'weeks', label: 'from first call to a live site' },
  { value: '100', unit: '%', label: 'yours. Site, content, and files' },
  { value: '30', unit: 'days', label: 'of free changes after launch' },
  { value: '1', unit: '', label: 'price you see before we build' },
];
---

<section class="hero container" id="top">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Websites for local businesses</p>
      <h1>Your customer is on their phone right now.</h1>
      <p class="hero__sub">
        A website that gets you orders, calls, and bookings. Say where you are, what you serve, how to order, and how to find you. We hook it up to DoorDash, Uber Eats, maps, you name it.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#contact">
          Get your price
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href="#why">Why a website?</a>
      </div>
      <p class="hero__note">No tech skills needed. We take care of the hard parts.</p>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="browser">
        <div class="browser__bar">
          <span class="browser__dot"></span><span class="browser__dot"></span><span class="browser__dot"></span>
          <span class="browser__url">harborkitchenmd.com</span>
        </div>
        <div class="browser__body">
          <p class="browser__crown">4.9 ★ · 126 reviews · Opens at 11:00</p>
          <h3 class="browser__name">Harbor Kitchen</h3>
          <p class="browser__tagline">Family-owned · Greek &amp; Mediterranean</p>

          <div class="browser__menu">
            <div class="menu-item"><span class="menu-item__name">Lamb Souvlaki Plate</span><span class="menu-item__price">$19</span></div>
            <div class="menu-item"><span class="menu-item__name">Moussaka</span><span class="menu-item__price">$17</span></div>
            <div class="menu-item"><span class="menu-item__name">Grilled Octopus</span><span class="menu-item__price">$23</span></div>
            <div class="menu-item"><span class="menu-item__name">Baklava</span><span class="menu-item__price">$7</span></div>
          </div>

          <div class="browser__actions">
            <span class="browser__btn">Call to order</span>
            <span class="browser__btn browser__btn--ghost">Book a table</span>
          </div>
          <div class="browser__deliver">
            <span>Order on</span>
            <span class="deliver-chip">DoorDash</span>
            <span class="deliver-chip">Uber Eats</span>
            <span class="deliver-chip">Grubhub</span>
          </div>
        </div>
      </div>

      <div class="hero-chip hero-chip--top">
        <span class="hero-chip__label">EXAMPLE SITE</span>
        <span class="hero-chip__value">See how it works</span>
      </div>
      <div class="hero-chip hero-chip--bottom">
        <span class="hero-chip__label">BACK TO YOU</span>
        <span class="hero-chip__value">You own this. 100%</span>
      </div>
    </div>
  </div>

  <div class="hero__stats">
    {stats.map((s) => (
      <div class="stat">
        <span class="stat__value">{s.value}<span class="stat__unit">{s.unit}</span></span>
        <span class="stat__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero { padding-top: 72px; }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: center; }
  .hero h1 { font-size: clamp(2.6rem, 5.2vw, 3.9rem); letter-spacing: -0.035em; line-height: 1.05; }
  .hero__sub { margin-top: 22px; font-size: 1.16rem; color: var(--ink-2); max-width: 52ch; }
  .hero__actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 32px; }
  .hero__note { margin-top: 16px; font-size: 0.88rem; color: var(--ink-3); }

  .hero__visual { position: relative; }
  .browser {
    background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-md);
    box-shadow: var(--shadow-md); overflow: hidden;
  }
  .browser__bar {
    display: flex; align-items: center; gap: 6px; padding: 11px 14px;
    border-bottom: 1px solid var(--line); background: var(--paper-2);
  }
  .browser__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); }
  .browser__dot:nth-child(1) { background: #e07a56; }
  .browser__dot:nth-child(2) { background: #e3b55c; }
  .browser__dot:nth-child(3) { background: #6fae74; }
  .browser__url {
    margin-left: 8px; font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3);
    background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 3px 10px;
  }
  .browser__body { padding: 24px 26px 26px; }
  .browser__crown { font-family: var(--font-mono); font-size: 0.7rem; color: var(--star); letter-spacing: 0.06em; }
  .browser__name { font-size: 1.5rem; margin-top: 6px; }
  .browser__tagline { color: var(--ink-2); font-size: 0.85rem; margin-top: 2px; }
  .browser__menu { margin-top: 18px; border-top: 1px dashed var(--line-2); }
  .menu-item {
    display: flex; justify-content: space-between; gap: 16px;
    padding: 9px 0; border-bottom: 1px dashed var(--line);
    font-size: 0.88rem;
  }
  .menu-item__price { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-3); }
  .browser__actions { display: flex; gap: 10px; margin-top: 18px; }
  .browser__btn {
    background: var(--accent); color: #fff; border-radius: var(--r-pill); padding: 10px 18px;
    font-size: 0.8rem; font-weight: 600;
  }
  .browser__btn--ghost { background: transparent; color: var(--ink); border: 1px solid var(--line-2); }
  .browser__deliver { display: flex; align-items: center; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .browser__deliver > span:first-child { font-size: 0.76rem; color: var(--ink-3); }
  .deliver-chip {
    font-size: 0.72rem; font-weight: 600; color: var(--ink-2);
    background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--r-pill);
    padding: 5px 12px;
  }

  .hero-chip {
    position: absolute; display: flex; flex-direction: column; gap: 2px;
    background: var(--card); border: 1px solid var(--line-2); border-radius: var(--r-sm);
    padding: 10px 16px; box-shadow: var(--shadow-md);
  }
  .hero-chip--top { top: -18px; left: -22px; }
  .hero-chip--bottom { bottom: -20px; right: -14px; }
  .hero-chip__label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; color: var(--ink-3); }
  .hero-chip__value { font-weight: 620; font-size: 0.86rem; color: var(--ok); }

  .hero__stats {
    margin-top: 72px; padding-top: 30px; border-top: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
  }
  .stat { display: flex; flex-direction: column; gap: 4px; }
  .stat__value { font-size: 1.7rem; font-weight: 650; letter-spacing: -0.02em; }
  .stat__unit { font-size: 0.95rem; color: var(--accent); margin-left: 2px; font-weight: 600; }
  .stat__label { font-size: 0.85rem; color: var(--ink-3); }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; gap: 56px; }
    .hero__stats { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .hero-chip--top { left: 8px; top: -16px; }
    .hero-chip--bottom { right: 8px; bottom: -18px; }
  }
  @media (max-width: 560px) {
    .hero { padding-top: 48px; }
    .hero__stats { grid-template-columns: 1fr 1fr; }
  }
</style>