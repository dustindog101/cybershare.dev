---
const locals = [
  {
    name: 'Sheba Ethiopian',
    city: 'Rockville, MD',
    rating: '4.8',
    count: '300+ reviews',
    quote: 'Always the best food, and the family that runs this restaurant is amazing. You feel appreciated as a customer.',
    monogram: 'S',
  },
  {
    name: 'Temari Café',
    city: 'Rockville, MD',
    rating: '4.6',
    count: '250+ reviews',
    quote: 'Cozy and homey, like a Japanese family diner. The ramen, with its rich broth, is the reason people come.',
    monogram: 'T',
  },
  {
    name: 'Regina\'s Restaurant',
    city: 'Wheaton, MD',
    rating: '4.7',
    count: '140+ reviews',
    quote: 'A warm neighborhood spot where the chicken marsala is a standout and portions are generous.',
    monogram: 'R',
  },
  {
    name: 'Kenwood Sunoco',
    city: 'Bethesda, MD',
    rating: '4.9',
    count: '160+ reviews',
    quote: 'Most reliable and responsive auto service in Bethesda. Three generations of the same family have trusted them.',
    monogram: 'K',
  },
  {
    name: 'Japanese Car Care',
    city: 'Towson, MD',
    rating: '4.9',
    count: '30+ reviews',
    quote: 'Best mechanic they\'ve had. Honest, affordable, and tells you what really needs fixing, not what sells.',
    monogram: 'J',
  },
  {
    name: 'JB Auto Repair',
    city: 'Gaithersburg, MD',
    rating: '4.9',
    count: '20 years open',
    quote: 'The family-owned Toyota specialist that treats every customer like family, in a 5-star habit.',
    monogram: 'JB',
  },
];
---

<section class="section container" id="locals">
  <div class="section-head reveal">
    <h2>The local places we build for</h2>
    <p>Good businesses, good reviews, looks familiar. The kind of places people search for on their phone and then walk in. These are real spots in our area.</p>
  </div>

  <div class="locals">
    {locals.map((l, i) => (
      <article class="local reveal" style={`transition-delay: ${(i % 3) * 70}ms`}>
        <div class="local__head">
          <span class="local__monogram" aria-hidden="true">{l.monogram}</span>
          <div class="local__who">
            <h3 class="local__name">{l.name}</h3>
            <p class="local__city">{l.city}</p>
          </div>
        </div>
        <div class="local__rating">
          <span class="stars" aria-label={`${l.rating} out of 5 stars`}>★★★★★</span>
          <span class="local__meta">{l.rating} · {l.count}</span>
        </div>
        <blockquote class="local__quote">"{l.quote}"</blockquote>
      </article>
    ))}
  </div>

  <p class="locals__note reveal">
    The words above are taken from public Google reviews and shortened. We did not write them, and these are not our clients yet. This is the kind of business we build websites for.
  </p>
</section>

<style>
  .locals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .local {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 26px 26px 22px; box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column; gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .local:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .local__head { display: flex; align-items: center; gap: 12px; }
  .local__monogram {
    width: 42px; height: 42px; flex: none; border-radius: 50%;
    background: linear-gradient(135deg, #d96a2b, #7a1f0d); color: #fff8f0;
    display: grid; place-items: center; font-weight: 650; font-size: 0.95rem;
  }
  .local__name { font-size: 1.02rem; letter-spacing: -0.01em; }
  .local__city { font-size: 0.8rem; color: var(--ink-3); }
  .local__rating { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .local__meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-3); }
  .local__quote {
    font-size: 0.93rem; color: var(--ink-2); line-height: 1.55;
    border-top: 1px dashed var(--line-2); padding-top: 14px; flex: 1;
  }
  .locals__note { margin-top: 26px; font-size: 0.82rem; color: var(--ink-3); }

  @media (max-width: 960px) {
    .locals { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .locals { grid-template-columns: 1fr; }
  }
</style>