---
const rows = [
  {
    title: 'What kind of site do you need?',
    body: 'A simple one-page site with your hours and phone, or a bigger one with a menu, reviews, and extra pages. The size sets the price.',
  },
  {
    title: 'What does your business need?',
    body: 'Do customers order food online, book a repair, or just call? We add exactly what your business needs, no more, no less.',
  },
  {
    title: 'What extras do you want?',
    body: 'Photos of your food or your shop, a second language for your customers, help writing the words. You decide, we quote it clearly.',
  },
];
---

<section class="section container" id="pricing">
  <div class="section-head reveal">
    <h2>Your price, before we start</h2>
    <p>We do not list one price for everyone, because every business is different. Tell us a little about yours. We send you one clear price for everything, and you see it before we build anything.</p>
  </div>

  <div class="plans">
    {rows.map((r, i) => (
      <article class="plan reveal" style={`transition-delay: ${i * 70}ms`}>
        <span class="plan__num">0{i + 1}</span>
        <h3 class="plan__title">{r.title}</h3>
        <p class="plan__blurb">{r.body}</p>
      </article>
    ))}
  </div>

  <div class="promise reveal">
    <div class="promise__head">
      <h3>What we promise</h3>
      <p>So there are no surprises, ever.</p>
    </div>
    <div class="promise__chips">
      <span class="chip"><b>One price</b> for everything</span>
      <span class="chip"><b>You own</b> the site, 100%</span>
      <span class="chip"><b>No monthly fees</b> unless you want hosting</span>
      <span class="chip"><b>Free changes</b> for 30 days after launch</span>
      <span class="chip"><b>Plain English</b> help, any time</span>
    </div>
  </div>
</section>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  .plan {
    position: relative; background: var(--card); border: 1px solid var(--line); border-radius: var(--r-md);
    padding: 34px 30px; display: flex; flex-direction: column; gap: 12px; box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .plan:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .plan__num {
    font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.12em; color: var(--accent);
    text-transform: uppercase;
  }
  .plan__title { font-size: 1.15rem; letter-spacing: -0.015em; }
  .plan__blurb { color: var(--ink-2); font-size: 0.93rem; line-height: 1.6; }

  .promise {
    margin-top: 34px; background: var(--paper-2); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 26px 30px;
    display: flex; justify-content: space-between; align-items: center; gap: 26px; flex-wrap: wrap;
  }
  .promise h3 { font-size: 1.05rem; }
  .promise p { color: var(--ink-3); font-size: 0.86rem; margin-top: 2px; }
  .promise__chips { display: flex; gap: 10px; flex-wrap: wrap; }

  @media (max-width: 960px) {
    .plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; }
  }
</style>