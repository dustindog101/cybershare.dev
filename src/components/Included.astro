---
const items = [
  {
    title: 'Made for phones',
    body: 'Most of your customers look from a phone. Your site is built for that first: fast, big buttons, easy to read in one hand.',
  },
  {
    title: 'Google can find you',
    body: 'We set up the site so Google shows your address, hours, and reviews the right way, with a sitemap and clean pages.',
  },
  {
    title: 'Map and phone number',
    body: 'Your location on a real map and a call button right on the screen. No searching, no scrolling.',
  },
  {
    title: 'Two languages, if you want',
    body: 'Many owners serve customers in two languages. We can build the site in English plus one more, so no customer is left guessing.',
  },
  {
    title: 'Plain English help',
    body: 'No tech talk. We explain everything in simple words on the phone or over email, until it makes sense to you.',
  },
  {
    title: '30 days of free changes',
    body: 'After your site goes live, we make small changes for free for 30 days. New hours, new specials, new photos. Your feedback, our work.',
  },
];
---

<section class="section container" id="included">
  <div class="section-head reveal">
    <h2>Everything is included</h2>
    <p>No separate bills at the end. This is what you get on every site we build for you.</p>
  </div>

  <div class="inc">
    {items.map((item, i) => (
      <div class="inc__row reveal" style={`transition-delay: ${i * 60}ms`}>
        <span class="inc__check" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l5 5L20 7"/></svg>
        </span>
        <div>
          <h3 class="inc__title">{item.title}</h3>
          <p class="inc__body">{item.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .inc { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; background: var(--card); box-shadow: var(--shadow-sm); }
  .inc__row { display: flex; gap: 18px; padding: 26px 28px; border-bottom: 1px solid var(--line); }
  .inc__row:nth-child(odd) { border-right: 1px solid var(--line); }
  .inc__row:nth-last-child(-n+2) { border-bottom: 0; }
  .inc__check {
    flex: none; width: 34px; height: 34px; border-radius: 10px;
    background: var(--accent-soft); color: var(--accent-deep);
    display: grid; place-items: center;
  }
  .inc__title { font-size: 1.04rem; letter-spacing: -0.01em; }
  .inc__body { margin-top: 5px; color: var(--ink-2); font-size: 0.92rem; max-width: 46ch; }
  @media (max-width: 880px) {
    .inc { grid-template-columns: 1fr; }
    .inc__row:nth-child(odd) { border-right: 0; }
    .inc__row:nth-last-child(-n+2) { border-bottom: 1px solid var(--line); }
    .inc__row:last-child { border-bottom: 0; }
  }
</style>